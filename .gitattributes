# Line-ending policy: hamma matn fayllar repoda LF bilan saqlanadi.
# Bu Windows (\\wsl$ orqali) va WSL tahrirlovchilari aralash ishlaganda
# paydo bo'ladigan doimiy CRLF/LF "dirty file" muammosini butunlay yopadi.
* text=auto eol=lf

# Binary fayllar — hech qachon konvertatsiya qilinmasin
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.db binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pfb binary
*.wasm binary

# Vendored PDF.js (static/vendor/pdfjs) — upstream baytlari o'zgarmasin.
# Fayl checksumlari static/vendor/pdfjs/README.md da qayd etilgan; git
# normalizatsiyasi ularni buzsa, provenance zanjiri uziladi.
static/vendor/** -text

# OAK manba fayli — bayt-ba-bayt saqlanishi SHART. Uning SHA-256 hash'i
# butun dataset provenance zanjirining asosi (data/oak/**, parser va testlar
# shu hash'ga bog'langan). Agar git CRLF -> LF normalizatsiya qilsa, klondan
# keyin hash o'zgaradi va tasdiqlangan review yozuvlari "boshqa revizya"
# bo'lib qoladi. Shuning uchun -text: hech qanday konvertatsiya yo'q.
data/oak/source/** -text

# STATIC_VERSION (utils/static_version.py): `git archive` replaces $Format:%H$ in
# BUILD_VERSION with the commit SHA, so a tree deployed from an archive (no .git)
# still knows which commit it was built from. Templates add it to CSS/JS URLs.
BUILD_VERSION export-subst
