# Olimlar.uz staging environment template.
# Copy to /opt/olimlar-staging/.env.staging on the staging host, set real values
# there, chmod 600, and never commit that populated file.

# Required security/runtime settings.
APP_ENV=production
DATABASE_URL=
SESSION_SECRET=

# Google OAuth (register a staging-only callback URL).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Telegram login and reminders.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
REMINDERS_API_KEY=

# AI and research integrations. OPENAI_API_KEY is reserved for staging tooling;
# the current application directly reads the other provider keys below.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OAK_API_KEY=
OPENALEX_MAILTO=

# Scraper-to-site integration. Use staging-only endpoint and key.
SITE_API_URL=
SITE_API_KEY=

# ATMOS sandbox/test credentials only.
ATMOS_CONSUMER_KEY=
ATMOS_CONSUMER_SECRET=
ATMOS_STORE_ID=
ATMOS_API_KEY=
ATMOS_API_BASE=
ATMOS_TEST_MODE=
