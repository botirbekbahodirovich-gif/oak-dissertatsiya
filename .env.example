# ── Olimlar.uz environment template ─────────────────────────────────────────
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored and must NEVER be committed.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string. Keep sslmode=require for the public
# endpoint (the app also auto-appends it for remote hosts if omitted).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Flask session / CSRF secret. Generate a strong random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-64-hex-chars

# ── OPTIONAL (features degrade gracefully if unset) ─────────────────────────

# Alternative DB var name, used only if DATABASE_URL is empty.
# POSTGRES_URL=

# AI assistant / analytics helpers.
GROQ_API_KEY=
GEMINI_API_KEY=
OAK_API_KEY=

# OpenAlex (maqolalar tahlili) — API kalit KERAK EMAS. mailto bilan "polite
# pool" (tezroq, barqaror javob) ishlaydi; istalgan haqiqiy email bo'ladi.
OPENALEX_MAILTO=info@olimlar.uz

# ── Ilmiy metadata provayderlari (DOI autofill, Phase 2C.1) ────────────────
# docs/article-metadata-integration.md
#
# Crossref va Unpaywall murojaat qiluvchining e-mailini so'raydi (Crossref —
# "polite pool" uchun ixtiyoriy, Unpaywall — MAJBURIY). Ular odatda bir xil
# bo'ladi, shuning uchun bitta umumiy qiymat yetarli:
SCHOLARLY_API_EMAIL=info@olimlar.uz
# Kerak bo'lsa har biri alohida ustidan yozilishi mumkin:
# CROSSREF_MAILTO=
# UNPAYWALL_EMAIL=
#
# OpenAlex kaliti IXTIYORIY: kalitsiz ham OPENALEX_MAILTO/SCHOLARLY_API_EMAIL
# bilan "polite pool" ishlaydi. Kalit faqat yuqori limit uchun. Ikkalasi ham
# bo'lmasa OpenAlex "sozlanmagan" bo'ladi va Crossref + Unpaywall ishlashda
# davom etadi.
OPENALEX_API_KEY=
#
# Timeout va kesh (odatda o'zgartirilmaydi):
# METADATA_CONNECT_TIMEOUT=4
# METADATA_READ_TIMEOUT=12
# METADATA_MAX_ATTEMPTS=2
# METADATA_TOTAL_BUDGET=20
# METADATA_CACHE_TTL=43200

# ── Ommaviy DOI/CSV import navbati (Phase 2C.2) ─────────────────────────────
# docs/article-bulk-import.md — odatda o'zgartirilmaydi.
# ARTICLE_IMPORT_MAX_ITEMS=500      # bitta partiyadagi maksimal DOI soni
# ARTICLE_IMPORT_CHUNK_SIZE=10      # bitta HTTP so'rovda ishlanadigan son
# ARTICLE_IMPORT_MAX_ATTEMPTS=3     # elementning maksimal qayta urinishi

# ── Rejalashtirilgan metadata sinxronizatsiyasi (Phase 2C.3C) ──────────────
# docs/article-metadata-scheduler.md — cron/systemd timer chaqiradi:
#   python3.12 scripts/sync_article_metadata.py
# ARTICLE_METADATA_SYNC_ENABLED=true
# ARTICLE_METADATA_SYNC_INTERVAL_DAYS=30   # bitta maqola qayta necha kunda tekshiriladi
# ARTICLE_METADATA_SYNC_BATCH_SIZE=50      # bitta run'dagi maksimal maqola soni

# Google OAuth login (cabinet). Redirect URI must be registered in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.olimlar.uz/auth/google/callback

# Telegram login widget / bot (legacy widget on pages other than /login;
# also used for chat notifications/reminders unrelated to login).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=send_kod_bot

# Telegram Login (OpenID Connect) used by /login. Obtained from @BotFather:
# pick the bot -> Login Widget -> register the Allowed URL
# (https://www.olimlar.uz + https://www.olimlar.uz/login/telegram/callback).
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=

# Scraper → site ingest API (GitHub Action secrets).
SITE_API_URL=
SITE_API_KEY=

# Smart Eslatmalar cron auth — X-API-Key for POST /api/v1/reminders/process
# (also set as the REMINDERS_API_KEY GitHub Action secret).
REMINDERS_API_KEY=

# ── ATMOS to'lov tizimi (blueprints/payments.py) ────────────────────────────
# Merchant kabinetidan olinadi. TEST rejimda test-checkout ishlatiladi.
ATMOS_CONSUMER_KEY=
ATMOS_CONSUMER_SECRET=
ATMOS_STORE_ID=
# Callback imzosini tekshirish kaliti (kabinetda "api_key" deb beriladi).
ATMOS_API_KEY=
# API bazasi (docs.atmos.uz bo'yicha standart qiymat).
ATMOS_API_BASE=https://apigw.atmos.uz
# true — sandbox: checkout test-checkout.pays.uz ga boradi; ATMOS hisob
# ma'lumotlari bo'sh bo'lsa lokal simulyatsiya rejimi yoqiladi.
ATMOS_TEST_MODE=false
# Callback sign hash algoritmi (md5|sha1|sha256) — ATMOS integratsiyasida
# aniqlashtiriladi; standart md5.
# ATMOS_CALLBACK_ALGO=md5
# Checkout bazasini majburan almashtirish (odatda kerak emas).
# ATMOS_CHECKOUT_BASE=https://checkout.pays.uz

# Port the app binds to. Leave unset on Cloud Run/App Engine (platform injects
# PORT); the container defaults to 8000 for the nginx-fronted VPS setup.
# PORT=8000
